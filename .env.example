# ── Supabase ───────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key (server-side only, NEVER expose to the browser).
# The MCP server does its own access control, so it uses the service role
# to bypass RLS and run the access-filtering RPCs.
SUPABASE_SERVICE_ROLE_KEY=

# ── Embeddings (OpenAI-compatible) ─────────────────────────
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL. Leave empty for OpenAI.
# Alibaba DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=
# OpenAI: text-embedding-3-small | DashScope: text-embedding-v4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Output dimension, pinned via the `dimensions` param. MUST match vector(N)
# in the migration. 1536 works for both 3-small and text-embedding-v4.
EMBEDDING_DIM=1536
# Vision model that describes uploaded images (the description is embedded so
# images are searchable in the same vector space). Must be served by the same
# OPENAI_BASE_URL / OPENAI_API_KEY. OpenAI: gpt-4o-mini | DashScope: qwen-vl-max
OPENAI_VISION_MODEL=gpt-4o-mini

# ── Supabase Storage (uploaded insight images) ─────────────
# Public bucket the server uploads image files to (created by setup_all.sql /
# 0004_images.sql). Override only if you renamed it.
SUPABASE_STORAGE_BUCKET=ja-insight-images

# ── Search ─────────────────────────────────────────────────
# Default minimum cosine similarity for semantic search: results scoring below
# this are dropped so weak/irrelevant matches don't surface. Callers can still
# override per query with `min_similarity` (0 = return everything). Raise it for
# stricter matching, lower it if relevant cross-lingual hits get filtered out.
SEARCH_MIN_SIMILARITY=0.2

# ── Read-only SQL (run_sql MCP tool) ───────────────────────
# DSN for the low-privilege `ja_reader` role created by migration 0006. This
# powers the run_sql tool, which lets a connecting agent write its own
# cross-table JOIN/aggregation queries. Leave EMPTY to disable the tool.
# NEVER use the service-role / postgres superuser here — those bypass RLS and
# would let any query read every tenant's rows. Example (Supabase direct conn):
#   postgresql://ja_reader:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
SUPABASE_READONLY_URL=
# run_sql guard rails.
SQL_MAX_ROWS=1000
SQL_TIMEOUT_MS=5000

# ── Audit log (agent ⇄ server tool calls) ──────────────────
# Persists every MCP tool call (tool, arguments, result summary, latency, user,
# session) to ja_tool_calls / ja_mcp_sessions (migration 0007). Set to 'off' to
# disable. AUDIT_STORE_RESULTS=full also stores the full returned payload
# (larger rows); default 'summary' keeps only metadata (found/count/row_count…).
AUDIT_LOG=on
AUDIT_STORE_RESULTS=summary

# ── HTTP server ────────────────────────────────────────────
PORT=8787
# Token that the ingest form must present (in addition to / instead of an
# admin API key) to POST new insights. Pick a long random string.
INGEST_TOKEN=

# Optional: comma-separated allowed origins for the submit form (CORS).
# Leave empty to disable cross-origin requests.
CORS_ORIGINS=
