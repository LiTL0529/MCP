# ── Supabase ───────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=
# Service-role key (server-side only, NEVER expose to the browser).
# The MCP server does its own access control, so it uses the service role
# to bypass RLS and run the access-filtering RPCs.
SUPABASE_SERVICE_ROLE_KEY=

# ── Embeddings (OpenAI-compatible) ─────────────────────────
OPENAI_API_KEY=
# Optional OpenAI-compatible base URL. Leave empty for OpenAI.
# Alibaba DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_BASE_URL=
# OpenAI: text-embedding-3-small | DashScope: text-embedding-v4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Output dimension, pinned via the `dimensions` param. MUST match vector(N)
# in the migration. 1536 works for both 3-small and text-embedding-v4.
EMBEDDING_DIM=1536
# Vision model that describes uploaded images (the description is embedded so
# images are searchable in the same vector space). Must be served by the same
# OPENAI_BASE_URL / OPENAI_API_KEY. OpenAI: gpt-4o-mini | DashScope: qwen-vl-max
OPENAI_VISION_MODEL=gpt-4o-mini

# ── Supabase Storage (uploaded insight images) ─────────────
# Public bucket the server uploads image files to (created by setup_all.sql /
# 0004_images.sql). Override only if you renamed it.
SUPABASE_STORAGE_BUCKET=ja-insight-images

# ── HTTP server ────────────────────────────────────────────
PORT=8787
# Token that the ingest form must present (in addition to / instead of an
# admin API key) to POST new insights. Pick a long random string.
INGEST_TOKEN=

# Optional: comma-separated allowed origins for the submit form (CORS).
# Leave empty to disable cross-origin requests.
CORS_ORIGINS=
